#!/usr/bin/env python3
"""check-site - the generated GitHub Pages surface, made checkable.

`scripts/gen-site` renders the pages; this gate proves the rendered tree is
complete and honest:

  - the page set is exactly the generator's list (no hand-authored orphan, no
    missing page);
  - every page carries a title, a description, a canonical URL, the social
    cards, the shared stylesheet, the nav, and the release/canon stamp;
  - every relative link and image resolves, and no generated page links a
    markdown source;
  - every numeric claim the pages make agrees with the measured count
    (`scripts/check-measurement --json`, the DSH presets, the installer, the
    art sets), so a hardcoded number fails exactly like a stale one;
  - no page carries the public leak patterns from `security/leak-patterns.txt`;
  - no page claims an older release or canon revision.

Usage: python scripts/check-site [--root <dir>]
Exit 0 = clean; 1 = findings; 2 = usage. Stdlib only. The rendered source
books are excluded from the numeric check; their gates own their numbers.
"""

from __future__ import annotations

import html as html_module
import json
import re
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PAGE_GLOBS = ("*.html", "seats/*.html", "lore/*.html")
REQUIRED_META = (
    'name="description"',
    'rel="canonical"',
    'property="og:title"',
    'property="og:description"',
    'property="og:url"',
    'property="og:image"',
    'name="twitter:card"',
)

VERSION = ""
CANON_REV = ""
COUNTS: dict[str, int] = {}


def resolve_root(argv: list[str]) -> Path:
    for index, arg in enumerate(argv):
        if arg == "--root" and index + 1 < len(argv):
            return Path(argv[index + 1]).resolve()
        if arg.startswith("--root="):
            return Path(arg.split("=", 1)[1]).resolve()
    return ROOT


def strip_root(argv: list[str]) -> list[str]:
    stripped: list[str] = []
    index = 0
    while index < len(argv):
        if argv[index] == "--root":
            index += 2
            continue
        if argv[index].startswith("--root="):
            index += 1
            continue
        stripped.append(argv[index])
        index += 1
    return stripped


def read(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""


def pages(root: Path) -> list[Path]:
    found: list[Path] = []
    for pattern in PAGE_GLOBS:
        found.extend(sorted(root.glob(pattern)))
    return found


def expected_pages(root: Path) -> list[str]:
    completed = subprocess.run(
        [sys.executable, str(root / "scripts" / "gen-site"), "--list", "--root", str(root)],
        capture_output=True, text=True, encoding="utf-8", timeout=300,
    )
    if completed.returncode != 0:
        raise SystemExit("check-site: gen-site --list failed:\n" + completed.stderr)
    return [line.strip() for line in completed.stdout.splitlines() if line.strip()]


def measured(root: Path) -> dict[str, int]:
    completed = subprocess.run(
        [sys.executable, str(root / "scripts" / "check-measurement"), "--json", "--root", str(root)],
        capture_output=True, text=True, encoding="utf-8", timeout=300,
    )
    if completed.returncode != 0:
        raise SystemExit("check-site: check-measurement --json failed:\n" + completed.stderr)
    data = json.loads(completed.stdout)
    values = {row["label"]: int(row["count"]) for row in data["rows"]}
    text = read(root / "setup")
    match = re.search(r'^ALL_HOSTS="([^"]+)"', text, re.M)
    values["hosts"] = len([name for name in match.group(1).split() if name != "dsh"]) if match else 0
    agents = root / "agents"
    values["dialects"] = len([p for p in agents.iterdir() if p.is_dir()]) if agents.is_dir() else 0
    values["presets"] = len(re.findall(r"^\s*- id: preset-", read(root / "dsh" / "animestack-house" / "cordis.patch.yml"), re.M))
    values["dossier cards"] = len(list((root / "art" / "dossiers").glob("*"))) if (root / "art" / "dossiers").is_dir() else 0
    values["character sheets"] = len(list((root / "art" / "sheets").glob("*"))) if (root / "art" / "sheets").is_dir() else 0
    values["wallpapers"] = len(list((root / "art" / "wallpapers").glob("*"))) if (root / "art" / "wallpapers").is_dir() else 0
    return values


CLAIM_LABELS = {
    "seats": "seats", "seat pages": "seat pages",
    "skills": "skills",
    "playbooks": "playbooks",
    "laws": "laws",
    "doctrine pieces": "doctrine pieces",
    "install targets": "install targets",
    "agent files": "agent files",
    "canon sections": "canon sections",
    "lore dossiers": "lore dossiers",
    "lore pages": "lore pages",
    "board questions": "board questions",
    "board seats": "board seats",
    "claim cards": "claim cards",
    "seat packs": "seat packs",
    "presets": "presets",
    "dialects": "dialects",
    "hosts": "hosts",
    "dossier cards": "dossier cards",
    "character sheets": "character sheets",
    "wallpapers": "wallpapers",
    "site art images": "site art images",
    "site thumbnails": "site thumbnails",
    "art library": "art library, total",
    "record rows": "record rows",
    "pattern registry entries": "pattern registry entries",
    "leak patterns": "leak patterns",
}
WORD_NUMBERS = {
    "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6,
    "seven": 7, "eight": 8, "nine": 9, "ten": 10, "eleven": 11,
    "twelve": 12, "thirteen": 13, "fourteen": 14, "fifteen": 15,
    "sixteen": 16, "seventeen": 17, "eighteen": 18, "nineteen": 19,
    "twenty": 20, "twenty-five": 25,
}
NUMBER_WORD = "|".join(sorted(WORD_NUMBERS, key=len, reverse=True))
LABEL_WORD = "|".join(sorted(CLAIM_LABELS, key=len, reverse=True))
CLAIM_RE = re.compile(
    r"(?<![A-Za-z0-9])(?P<num>\d{1,3}|%s)\s+(?P<label>%s)(?![A-Za-z])" % (NUMBER_WORD, LABEL_WORD),
    re.I,
)
STALE_RELEASE_RE = re.compile(r"\u00b7\s*v(\d+\.\d+\.\d+)\s*\u00b7")
CANON_CLAIM_RE = re.compile(r"(?i)canon\s*(?:[\u00b7:\u2014\u2013-]\s*)?Rev\s*(\d+)")


def chrome(text: str) -> str:
    """The page's own copy: the shell, headers, stats, and cards.

    Rendered source books are checked by their own gates (the canon by
    check-lore-consistency, the board by check-board, the counts by
    check-measurement); the site's claim is the chrome it composes. Excluding
    the books keeps a historical sentence ("the seven-seat origin") from
    reading as a stale pack count.
    """
    text = re.sub(r"<article class=\"book\">.*?</article>", " ", text, flags=re.S)
    text = re.sub(r"<section class=\"zone\".*?</section>", " ", text, flags=re.S)
    return text


def check_page(root: Path, path: Path, failures: list[str]) -> int:
    rel = path.relative_to(root).as_posix()
    text = read(path)
    for marker in REQUIRED_META:
        if marker not in text:
            failures.append("%s: missing %s" % (rel, marker))
    if "assets/css/site.css" not in text:
        failures.append("%s: shared stylesheet missing" % rel)
    if "<nav>" not in text or 'class="nav-links"' not in text:
        failures.append("%s: nav missing" % rel)
    own = chrome(text)
    for match in CANON_CLAIM_RE.finditer(own):
        if match.group(1) != CANON_REV:
            failures.append("%s: claims canon Rev %s, canon.md says %s" % (rel, match.group(1), CANON_REV))
    for match in STALE_RELEASE_RE.finditer(own):
        if match.group(1) != VERSION:
            failures.append("%s: claims v%s, VERSION says %s" % (rel, match.group(1), VERSION))
    if "· v%s ·" % VERSION not in own:
        failures.append("%s: no current release stamp" % rel)
    base = path.parent
    for match in re.finditer(r'(?:href|src)="([^"]+)"', text):
        target = html_module.unescape(match.group(1))
        if target.startswith(("http://", "https://", "mailto:", "#")):
            continue
        clean = target.split("#", 1)[0].split("?", 1)[0]
        if not clean:
            continue
        if clean.endswith(".md"):
            failures.append("%s: links a markdown source (%s)" % (rel, target))
            continue
        if not (base / clean).exists():
            failures.append("%s: dead link/image %s" % (rel, target))
    plain = re.sub(r"<[^>]+>", " ", own)
    plain = html_module.unescape(plain)
    plain = re.sub(r"\s+", " ", plain)
    claims = 0
    for match in CLAIM_RE.finditer(plain):
        raw = match.group("num").lower()
        number = int(raw) if raw.isdigit() else WORD_NUMBERS.get(raw)
        key = CLAIM_LABELS[match.group("label").lower()]
        if number is None or key not in COUNTS:
            continue
        claims += 1
        if number != COUNTS[key]:
            failures.append(
                "%s: claims %s %s, measured %d" % (rel, match.group("num"), key, COUNTS[key])
            )
    return claims


def scan_patterns(root: Path, path: Path, failures: list[str]) -> None:
    rules = []
    for line in read(root / "security" / "leak-patterns.txt").splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        try:
            rules.append((parts[0], re.compile(parts[1])))
        except re.error:
            failures.append("%s: rule %s does not compile" % (path.name, parts[0]))
    text = read(path)
    for rule_id, pattern in rules:
        match = pattern.search(text)
        if match:
            failures.append("%s: leak rule %s matched %r" % (path.relative_to(root).as_posix(), rule_id, match.group(0)))


def main(argv: list[str]) -> int:
    if strip_root(argv):
        print("usage: python scripts/check-site [--root <dir>]", file=sys.stderr)
        return 2
    root = resolve_root(argv)
    global VERSION, CANON_REV, COUNTS
    VERSION = read(root / "VERSION").strip()
    match = re.search(r"\*\*Revision:\*\*\s*(\d+)", read(root / "docs" / "lore" / "canon.md"))
    CANON_REV = match.group(1) if match else ""
    COUNTS = measured(root)

    failures: list[str] = []
    expected = expected_pages(root)
    actual = sorted(path.relative_to(root).as_posix() for path in pages(root))
    for path in expected:
        if path.endswith(".html") and path not in actual:
            failures.append("%s: expected page missing" % path)
    for path in actual:
        if path not in expected:
            failures.append("%s: page not in the generator's list" % path)
    claims_seen = 0
    for path in pages(root):
        claims_seen += check_page(root, path, failures)
        scan_patterns(root, path, failures)
    for svg in sorted((root / "assets").rglob("*.svg")):
        try:
            ET.parse(svg)
        except ET.ParseError as exc:
            failures.append("%s: invalid SVG (%s)" % (svg.relative_to(root).as_posix(), exc))
    sitemap = read(root / "sitemap.xml")
    for path in actual:
        if path == "404.html":
            continue
        if "https://animestack.jerkyjesse.com/%s" % path not in sitemap:
            failures.append("sitemap.xml: missing %s" % path)
    if not read(root / "robots.txt").strip().endswith("sitemap.xml"):
        failures.append("robots.txt: sitemap line missing")
    if failures:
        print("check-site: FAILED (%d issue(s), %d pages, %d numeric claims)" % (len(failures), len(actual), claims_seen))
        for failure in failures:
            print("  - %s" % failure)
        return 1
    print("check-site: clean (%d pages, %d numeric claims, links and meta resolve)" % (len(actual), claims_seen))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
