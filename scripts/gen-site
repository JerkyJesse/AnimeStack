#!/usr/bin/env python3
"""gen-site - the GitHub Pages surface, generated from the tree.

The site is not authored. Every page is rendered from a source file the rest of
the pack already gates: the canon and its lore books, the board, the counts,
the record rows, the claim standard, the security gate, the DSH surface, the
playbook shelf, and the guide. A page that disagrees with its source is a
generator defect, not an editorial choice.

Every number in a page comes from `scripts/check-measurement --json`, from a
file count the page names, or from the record itself; `scripts/check-site`
re-derives those numbers and fails on a hardcoded claim.

Usage:
    python scripts/gen-site            write the pages
    python scripts/gen-site --check    render in memory and compare (no writes)
    python scripts/gen-site --list     print the page paths, one per line
    python scripts/gen-site --root <dir>

Exit 0 = written or in sync; 1 = --check found a stale page or an unread
source; 2 = usage. Stdlib only; no network.
"""

from __future__ import annotations

import html
import json
import posixpath
import re
import subprocess
import sys
from pathlib import Path

