#!/usr/bin/env python3
"""Generate the per-host agent dialects from the claude sources.

Maintenance tool, not an installer. Edit agents/claude, run this script, commit
the generated trees; setup installs the committed trees and audits their
frontmatter. No network. Python 3.11+ for tomllib self-checks.

Usage: python3 scripts/gen-agent-dialects [--check]

--check regenerates in memory and compares against the committed trees without
writing: drift, a missing or extra generated file exits 1, so a hand-edited
dialect fails closed. Line endings are normalized before comparison (git
text=auto may hand out CRLF working copies).

Every generated file - and the claude sources they are generated from - carries
the canon revision and an inputs hash over the canon and the dossiers; the
stamp is refreshed with the trees and verified by --check.

Dialects:
  cursor   agents/cursor/*.md    name + description; no model key
  kiro     agents/kiro/*.md      name + description; no model key
  factory  agents/factory/*.md   claude form verbatim (model: inherit)
  codex    agents/codex/*.toml   name, description, developer_instructions
  factory  agents/factory/command/house.md  copy of the opencode command

The opencode tree (agents/opencode) is hand-authored: the script refreshes its
provenance stamp in place and --check verifies it; the body is never regenerated.
"""

from __future__ import annotations

import hashlib
import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "agents" / "claude"
COMMAND_SRC = ROOT / "agents" / "opencode" / "command" / "house.md"
OPENCODE = ROOT / "agents" / "opencode"
CANON = ROOT / "docs" / "lore" / "canon.md"
DOSSIERS = sorted((ROOT / "docs" / "lore" / "dossiers").glob("*.md"))
STAMP_RE = re.compile(r"^<!-- animestack canon rev \d+ :: inputs sha256=[0-9a-f]{64} -->$")
STAMP_RE_TOML = re.compile(r"^# animestack canon rev \d+ :: inputs sha256=[0-9a-f]{64}$")

OWN_MARKER = "<!-- animestack-owned -->"
TOML_MARKER = "# animestack-owned"

GENERATED_DIRS = (
    ROOT / "agents" / "claude",
    ROOT / "agents" / "cursor",
    ROOT / "agents" / "kiro",
    ROOT / "agents" / "factory",
    ROOT / "agents" / "codex",
)

# Body rewrites per dialect: the phrase names a tool the host does not expose.
# The house spawns subagents everywhere; only the tool name differs.
BODY_REWRITES = {
    "codex": [("as subagents via the Task tool,", "as subagents,")],
    "kiro": [("as subagents via the Task tool,", "as subagents,")],
}


def split_frontmatter(text: str) -> tuple[str, str]:
    if not text.startswith("---\n"):
        raise ValueError("missing frontmatter opener")
    end = text.index("\n---\n", 4)
    return text[4:end], text[end + len("\n---\n") :]


def field(frontmatter: str, key: str) -> str:
    for line in frontmatter.splitlines():
        if line.startswith(f"{key}: "):
            return line[len(key) + 2 :]
    raise ValueError(f"missing frontmatter field: {key}")


def drop_model(frontmatter: str) -> str:
    return "\n".join(line for line in frontmatter.splitlines() if not line.startswith("model:"))


def toml_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"""', '""\\"')


def lore_stamp() -> tuple[str, str]:
    canon = CANON.read_text(encoding="utf-8").replace("\r\n", "\n")
    match = re.search(r"Revision:\*\*\s*(\d+)", canon)
    rev = match.group(1) if match else "?"
    parts = [canon]
    for dossier in DOSSIERS:
        parts.append(dossier.read_text(encoding="utf-8").replace("\r\n", "\n"))
    digest = hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()
    return rev, digest


def strip_stamp(text: str) -> str:
    kept = []
    skip_blank = False
    for line in text.splitlines():
        if STAMP_RE.match(line) or STAMP_RE_TOML.match(line):
            skip_blank = True
            continue
        if skip_blank and line == "":
            skip_blank = False
            continue
        skip_blank = False
        kept.append(line)
    return "\n".join(kept)


def stamp_md(rev: str, digest: str) -> str:
    return f"<!-- animestack canon rev {rev} :: inputs sha256={digest} -->"


def stamp_toml(rev: str, digest: str) -> str:
    return f"# animestack canon rev {rev} :: inputs sha256={digest}"


def build() -> tuple[dict[Path, str], dict[str, int]] | None:
    sources = sorted(SRC.glob("*.md"))
    if len(sources) != 7:
        print(f"error: expected 7 claude agents, found {len(sources)}", file=sys.stderr)
        return None

    rev, digest = lore_stamp()
    stamp = stamp_md(rev, digest)
    outputs: dict[Path, str] = {}
    counts = {"claude": 0, "cursor": 0, "kiro": 0, "factory": 0, "codex": 0, "factory_command": 1, "opencode": 0}

    for src in sources:
        text = src.read_text(encoding="utf-8")
        frontmatter, body = split_frontmatter(text)
        body = strip_stamp(body)
        name = field(frontmatter, "name")
        description = field(frontmatter, "description")
        stem = src.stem

        claude_content = f"---\n{frontmatter}\n---\n{stamp}\n\n{body}"
        outputs[src] = claude_content
        counts["claude"] += 1

        for dialect in ("cursor", "kiro"):
            content = f"---\n{drop_model(frontmatter)}\n---\n{stamp}\n\n{body}"
            if not content.rstrip().endswith(OWN_MARKER):
                print(f"error: {dialect}/{stem} lost the ownership marker", file=sys.stderr)
                return None
            outputs[ROOT / "agents" / dialect / f"{stem}.md"] = content
            counts[dialect] += 1

        outputs[ROOT / "agents" / "factory" / f"{stem}.md"] = claude_content
        counts["factory"] += 1

        codex_body = body
        for old, new in BODY_REWRITES["codex"]:
            codex_body = codex_body.replace(old, new)
        codex_body = codex_body.rstrip()
        if codex_body.endswith(OWN_MARKER):
            codex_body = codex_body[: -len(OWN_MARKER)].rstrip()
        codex_body = codex_body.lstrip("\n")
        toml = (
            f'name = "{toml_escape(name)}"\n'
            f'description = "{toml_escape(description)}"\n'
            f'developer_instructions = """\n{toml_escape(codex_body)}\n"""\n'
            f"\n{stamp_toml(rev, digest)}\n{TOML_MARKER}\n"
        )
        parsed = tomllib.loads(toml)
        if parsed.get("name") != name or "developer_instructions" not in parsed:
            print(f"error: codex/{stem}.toml failed the tomllib self-check", file=sys.stderr)
            return None
        outputs[ROOT / "agents" / "codex" / f"{stem}.toml"] = toml
        counts["codex"] += 1

    command_text = COMMAND_SRC.read_text(encoding="utf-8")
    command_frontmatter, command_body = split_frontmatter(command_text)
    command_body = strip_stamp(command_body).lstrip("\n")
    outputs[ROOT / "agents" / "factory" / "command" / "house.md"] = (
        f"---\n{command_frontmatter}\n---\n{stamp}\n\n{command_body}"
    )
    opencode = opencode_outputs(stamp)
    if opencode is None:
        return None
    outputs.update(opencode)
    counts["opencode"] = len(opencode)
    return outputs, counts


def opencode_outputs(stamp: str) -> dict[Path, str] | None:
    sources = sorted((ROOT / "agents" / "claude").glob("*.md"))
    paths = [OPENCODE / f"{src.stem}.md" for src in sources]
    paths.append(OPENCODE / "command" / "house.md")
    outputs: dict[Path, str] = {}
    for path in paths:
        if not path.is_file():
            print(f"error: missing opencode file: {path.relative_to(ROOT).as_posix()}", file=sys.stderr)
            return None
        text = path.read_text(encoding="utf-8").replace("\r\n", "\n")
        frontmatter, body = split_frontmatter(text)
        body = strip_stamp(body).lstrip("\n")
        outputs[path] = f"---\n{frontmatter}\n---\n{stamp}\n\n{body}"
    return outputs


def check(outputs: dict[Path, str]) -> int:
    failures: list[str] = []
    for path, content in sorted(outputs.items()):
        rel = path.relative_to(ROOT).as_posix()
        if not path.exists():
            failures.append(f"missing: {rel}")
            continue
        actual = path.read_text(encoding="utf-8").replace("\r\n", "\n")
        if actual != content:
            failures.append(f"drift: {rel}")
    expected = set(outputs)
    for directory in GENERATED_DIRS:
        if not directory.exists():
            continue
        for path in sorted(directory.rglob("*")):
            if path.is_file() and path not in expected:
                failures.append(f"extra: {path.relative_to(ROOT).as_posix()}")
    if failures:
        print(f"gen-agent-dialects: FAILED ({len(failures)} issue(s))")
        for failure in failures:
            print("  " + failure)
        return 1
    print(f"gen-agent-dialects: in sync ({len(outputs)} files)")
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args not in ([], ["--check"]):
        print("usage: python3 scripts/gen-agent-dialects [--check]", file=sys.stderr)
        return 2
    built = build()
    if built is None:
        return 1
    outputs, counts = built
    if args == ["--check"]:
        return check(outputs)
    for directory in GENERATED_DIRS:
        directory.mkdir(parents=True, exist_ok=True)
    (ROOT / "agents" / "factory" / "command").mkdir(parents=True, exist_ok=True)
    for path, content in sorted(outputs.items()):
        path.write_text(content, encoding="utf-8", newline="\n")
    for dialect, count in counts.items():
        print(f"generated: {dialect} {count}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
