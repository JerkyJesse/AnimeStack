#!/usr/bin/env python3
"""Consistency check: the seven seats' credential facts agree across surfaces.

Source of truth: docs/lore/canon.md (each seat's compact credentials line).
For every seat the art/graphics keys parsed from the canon tail must appear:

  - docs/seats/<seat>.md, README.md, and the agent sources (claude and
    opencode: the seat file): as the "art: <key>" /
    "graphics: <key>" tails;
  - docs/lore/dossiers/<seat>.md and seats/<seat>.html: inside the Art and
    Graphics bullets.

Key-phrase presence only: a surface keeps its own voice, a silent drop fails
closed. The same pass extends to the full compact credentials line: for every
seat, the canon line's non-art segments (split ·) must resolve against the
dossier **Credentials.** block with tolerant normalized matching - so a
dossier that silently drops a training, industry, or certification phrase
fails closed naming the seat and the segment. The generated dialect trees are
covered by gen-agent-dialects --check. The second pass resolves every
backticked repo path in the root docs and the lore corpus against the live
tree (relative to the citing file first, then the repo root), so a pointer
that rots fails closed.

Usage: python3 scripts/check-lore-consistency [--root <dir>]
Exit 0 = clean; 1 = failures printed; 2 = usage.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path


def _resolve_root(argv: list[str]) -> Path:
    for index, arg in enumerate(argv):
        if arg == "--root" and index + 1 < len(argv):
            return Path(argv[index + 1]).resolve()
        if arg.startswith("--root="):
            return Path(arg.split("=", 1)[1]).resolve()
    return Path(__file__).resolve().parents[1]


def _strip_root(argv: list[str]) -> list[str]:
    stripped: list[str] = []
    index = 0
    while index < len(argv):
        if argv[index] == "--root":
            index += 2
            continue
        if argv[index].startswith("--root="):
            index += 1
            continue
        stripped.append(argv[index])
        index += 1
    return stripped


ROOT = _resolve_root(sys.argv[1:])
SEATS = ("reika", "yui", "rin", "niko", "mei", "aria", "elo")
TREE_SUFFIXES = {
    "claude": ("",),
    "opencode": ("",),
}

ART_KEY_RE = re.compile(r"art: (.+?)(?: \(| · graphics:)")
GRAPHICS_KEY_RE = re.compile(r"graphics: (.+?)\.")
CRED_LINE_RE = re.compile(r"^\*\*Credentials\.\*\* (.+)$", re.MULTILINE)
CRED_MARKER_RE = re.compile(r"^\*\*Credentials\.\*\*[^\r\n]*$", re.MULTILINE)
PATH_TOKEN_RE = re.compile(r"`([A-Za-z0-9_./-]+\.[A-Za-z0-9]+)`")

STOPWORDS = frozenset({
    "a", "an", "and", "as", "at", "by", "for", "from", "in", "is", "it",
    "no", "not", "of", "on", "or", "that", "the", "then", "to", "was", "with",
})
# Register drift tolerated by design (key phrases only - each surface keeps its
# own voice): a token in this set may be absent from the dossier without
# failing. university - institution qualifier, dossiers may elide it ("PPE at
# Oxford"); published - paper status, dossiers may say "peer-reviewed" instead;
# degree - the "no degree" qualifier, dropped when the dossier names the desk.
ELIDABLE_TOKENS = frozenset({"university", "published", "degree"})


def path_token_exists(token: str, origin: Path) -> bool:
    if "<" in token or "*" in token or token.startswith("~") or "://" in token:
        return True
    if ":" in token or token.startswith("/"):
        return False
    if "/" not in token and token.startswith("_"):
        return True
    bases = (origin.parent, origin.parent.parent, ROOT)
    for base in bases:
        if (base / token).exists():
            return True
    return False


def check_path_tokens() -> tuple[list[str], int]:
    failures: list[str] = []
    checks = 0
    files = [ROOT / "README.md", ROOT / "AGENTS.md", ROOT / "CLAUDE.md"]
    lore = ROOT / "docs" / "lore"
    if lore.is_dir():
        files.extend(sorted(lore.rglob("*.md")))
    for path in files:
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        for token in sorted(set(PATH_TOKEN_RE.findall(text))):
            checks += 1
            if not path_token_exists(token, path):
                failures.append(
                    "%s: path missing: %s" % (path.relative_to(ROOT).as_posix(), token)
                )
    return failures, checks


def seat_block(canon: str, seat: str) -> str | None:
    match = re.search(
        rf"^###\s+[^\r\n]*\b{seat}\b[^\r\n]*\r?\n(.*?)(?=^###\s|\Z)",
        canon,
        re.MULTILINE | re.DOTALL | re.IGNORECASE,
    )
    return match.group(1) if match else None


def has_tail(text: str, kind: str, key: str) -> bool:
    return f"{kind}: {key}".lower() in text.lower()


def bullet_line(text: str, label: str, is_html: bool) -> str | None:
    if is_html:
        marker = f"<strong>{label}.</strong>"
        return next((line for line in text.splitlines() if marker in line), None)
    marker = f"- **{label}.**"
    return next((line for line in text.splitlines() if line.startswith(marker)), None)


def credentials_block(text: str) -> str | None:
    """The bullet lines under the **Credentials.** marker, up to the first
    non-bullet line (the dossier heading form)."""
    match = CRED_MARKER_RE.search(text)
    if match is None:
        return None
    collected: list[str] = []
    for line in text[match.end():].splitlines():
        stripped = line.strip()
        if stripped.startswith("- "):
            collected.append(stripped)
        elif stripped and collected:
            break
    return "\n".join(collected) if collected else None


def credential_segments(cred_line: str) -> list[str]:
    """Non-art segments of a compact credentials line (·-split)."""
    return [
        part.strip()
        for part in cred_line.split("·")
        if part.strip() and not part.strip().lower().startswith(("art:", "graphics:"))
    ]


def _tokens(text: str) -> list[str]:
    return re.findall(r"[^\W_]+", text.lower(), re.UNICODE)


def required_credential_tokens(segment: str) -> list[str]:
    return [
        token
        for token in dict.fromkeys(_tokens(segment))
        if token not in STOPWORDS and token not in ELIDABLE_TOKENS
    ]


def missing_credential_tokens(segment: str, dossier_block: str) -> list[str]:
    """Key-phrase presence: every required token must resolve in the dossier
    block by exact match or a >= 4-char shared prefix (morphological drift)."""
    pool = set(_tokens(dossier_block))
    return [
        token
        for token in required_credential_tokens(segment)
        if not any(
            candidate == token or (len(token) >= 4 and candidate.startswith(token))
            for candidate in pool
        )
    ]


def main() -> int:
    if _strip_root(sys.argv[1:]):
        print("usage: python3 scripts/check-lore-consistency [--root <dir>]", file=sys.stderr)
        return 2

    failures: list[str] = []
    checks = 0

    canon_path = ROOT / "docs" / "lore" / "canon.md"
    readme_path = ROOT / "README.md"
    canon = canon_path.read_text(encoding="utf-8") if canon_path.exists() else ""
    if not canon:
        failures.append("docs/lore/canon.md missing")
    readme = readme_path.read_text(encoding="utf-8") if readme_path.exists() else ""
    if not readme:
        failures.append("README.md missing")

    for seat in SEATS:
        block = seat_block(canon, seat)
        cred = CRED_LINE_RE.search(block) if block else None
        if cred is None:
            failures.append(f"canon: {seat} credentials line missing")
            continue
        art = ART_KEY_RE.search(cred.group(1))
        graphics = GRAPHICS_KEY_RE.search(cred.group(1))
        if art is None or graphics is None:
            failures.append(f"canon: {seat} art/graphics tail missing")
            continue
        keys = {"art": art.group(1).strip(), "graphics": graphics.group(1).strip()}

        surfaces: dict[str, str] = {"README.md": readme}
        seats_doc = ROOT / "docs" / "seats" / f"{seat}.md"
        surfaces[f"docs/seats/{seat}.md"] = (
            seats_doc.read_text(encoding="utf-8") if seats_doc.exists() else ""
        )
        for tree, suffixes in TREE_SUFFIXES.items():
            for suffix in suffixes:
                agent = ROOT / "agents" / tree / f"animestack-{seat}{suffix}.md"
                surfaces[agent.relative_to(ROOT).as_posix()] = (
                    agent.read_text(encoding="utf-8") if agent.exists() else ""
                )
        for label, text in surfaces.items():
            for kind in ("art", "graphics"):
                checks += 1
                if not has_tail(text, kind, keys[kind]):
                    failures.append(f"{seat}: {label} missing '{kind}: {keys[kind]}'")

        for label, rel, is_html in (
            ("dossier", f"docs/lore/dossiers/{seat}.md", False),
            ("seat page", f"seats/{seat}.html", True),
        ):
            path = ROOT / rel
            text = path.read_text(encoding="utf-8") if path.exists() else ""
            for kind, cap in (("art", "Art"), ("graphics", "Graphics")):
                checks += 1
                line = bullet_line(text, cap, is_html)
                if line is None or keys[kind].lower() not in line.lower():
                    failures.append(
                        f"{seat}: {label} {cap} bullet missing key {keys[kind]!r}"
                    )

        # The full compact credentials line: every non-art segment
        # (training / industry / certifications) must resolve against the
        # dossier **Credentials.** block. Tolerant normalized matching, key
        # phrases only; fail closed naming the seat and the segment.
        dossier_path = ROOT / "docs" / "lore" / "dossiers" / f"{seat}.md"
        dossier_text = (
            dossier_path.read_text(encoding="utf-8") if dossier_path.exists() else ""
        )
        block = credentials_block(dossier_text)
        segments = credential_segments(cred.group(1))
        if not segments:
            failures.append(f"canon: {seat} credentials line carries no checkable segment")
        elif block is None:
            failures.append(f"{seat}: dossier credentials block missing")
        else:
            for segment in segments:
                checks += 1
                if not required_credential_tokens(segment):
                    failures.append(
                        f"{seat}: credential segment has no checkable token: {segment!r}"
                    )
                    continue
                missing = missing_credential_tokens(segment, block)
                if missing:
                    failures.append(
                        f"{seat}: credential segment unresolved in dossier: {segment!r} "
                        f"(missing: {', '.join(missing)})"
                    )

    path_failures, path_checks = check_path_tokens()
    failures.extend(path_failures)
    checks += path_checks

    if failures:
        print(f"check-lore-consistency: FAILED ({len(failures)} issue(s), {checks} facts checked)")
        for failure in failures:
            print("  " + failure)
        return 1
    print(f"check-lore-consistency: clean ({checks} facts checked)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
